{
  "name": "Agent",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Agent's full name"
    },
    "email": {
      "type": "string",
      "description": "Agent email (login identity)"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "tenant_domain": {
      "type": "string",
      "description": "Email domain used for tenant isolation"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Suspended"
      ],
      "default": "Active",
      "description": "Account status"
    },
    "role": {
      "type": "string",
      "enum": [
        "agent",
        "super_user",
        "admin"
      ],
      "default": "agent",
      "description": "Account role - admin is platform owner, super_user manages their tenant"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether the super user has completed company onboarding"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "Last login timestamp"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_domain": "{{user.data.domain}}"
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "super_user"
              }
            },
            {
              "data.tenant_domain": "{{user.data.domain}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "super_user"
              }
            },
            {
              "data.tenant_domain": "{{user.data.domain}}"
            }
          ]
        }
      ]
    }
  }
}